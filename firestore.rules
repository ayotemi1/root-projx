rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────────────────
    // The API server signs in as this Firebase account for privileged ops.
    // Change this if FIREBASE_SERVER_EMAIL is overridden in your env vars.
    function isServer() {
      return request.auth != null &&
             request.auth.token.email == "seeder@rootprojx.internal";
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ── users ──────────────────────────────────────────────────────────────
    // Privileged fields are server-controlled. Supporters may create their own
    // basic profile and later edit only non-privileged presentation fields.
    match /users/{userId} {
      allow read:   if isOwner(userId) || isServer();
      allow create: if isServer() ||
        (isOwner(userId) &&
         request.resource.data.accountType == "supporter" &&
         !request.resource.data.keys().hasAny(["approvalStatus"]));
      allow update: if isServer() ||
        (isOwner(userId) &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(["name", "phone", "avatarInitials", "publicProfile"]));
      allow delete: if false;
    }

    // ── organisations ───────────────────────────────────────────────────────
    // The server projects public organisation fields through its API.
    // This document also embeds non-public campaign draft state, so client-side
    // reads would leak fields that Firestore rules cannot project away.
    // All writes go through the API so approval is enforced before mutation.
    match /organisations/{orgId} {
      allow read:   if isServer();
      allow create: if isServer();
      allow update: if isServer();
      allow delete: if false;
    }

    // ── updates (impact feed posts) ─────────────────────────────────────────
    // Public read. Writes go through the API's approved-organisation guard.
    match /updates/{updateId} {
      allow read: if true;
      allow create, update, delete: if isServer();
    }

    // ── follows ─────────────────────────────────────────────────────────────
    // Users can only see and manage their own follows.
    // Query for "my follows" works because the filter mirrors the rule.
    match /follows/{followId} {
      allow read:   if isServer() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isServer() ||
        (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow delete: if isServer() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if false;
    }

    // ── donations ───────────────────────────────────────────────────────────
    // Users can read their own donations (query WHERE userId == uid is safe
    // because the filter mirrors this rule). Only the server may write —
    // donations are created exclusively by Stripe webhooks / confirm endpoint.
    match /donations/{donationId} {
      allow read:  if isServer() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isServer();
    }

    // ── reviews ─────────────────────────────────────────────────────────────
    // Public read. Any authenticated user may create a review (one-shot).
    // Only server may update or delete.
    match /reviews/{reviewId} {
      allow read:          if true;
      allow create:        if isSignedIn();
      allow update, delete: if isServer();
    }

    // ── help_entries ────────────────────────────────────────────────────────
    // Public read. Only server may write (entries are managed via admin tools).
    match /help_entries/{entryId} {
      allow read:  if true;
      allow write: if isServer();
    }

    // ── supporters ──────────────────────────────────────────────────────────
    // Supporter profile docs (uid, name, email, phone, signedUpAt).
    // Written by server on registration. Only server may read or write.
    match /supporters/{uid} {
      allow read, write: if isServer();
    }

    // ── org_applications ────────────────────────────────────────────────────
    // Only the server (API) may read or write org applications.
    // Applications are submitted via server-authenticated API routes, not directly by clients.
    match /org_applications/{appId} {
      allow read, write: if isServer();
    }

    // ── catch-all: deny anything not explicitly matched ────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
