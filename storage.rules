rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Update media (photos/videos posted to the impact feed) must be readable
    // by anyone, including logged-out supporters browsing the public feed.
    // Writes are restricted to authenticated Firebase users (org accounts).
    match /updates/{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }

    // All other paths require authentication for both reads and writes.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
